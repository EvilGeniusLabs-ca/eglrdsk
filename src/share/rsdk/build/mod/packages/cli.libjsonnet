local base_packages = import "categories/base.libjsonnet";
local product_soc_array = import "../../../configs/product_soc_array.libjsonnet";

// EvilGeniusLabs cli edition (eglrdsk fork).
//
// Stock rsdk `cli` == base_packages: the lean headless userland layered over `core`.
// We keep that base set and add board-scoped tuning here, guarded by SoC so the delta never
// leaks into other products or the `kde` edition (which also pulls `base`):
//   - rk3566  — Radxa Zero 3 / 3W / 3E. Rationale + kde-vs-cli map: radxa-zero3-cli's
//               Documentation/rsdk-build-notes.md.
//   - a733    — Radxa Cubie A7A/A7S/A7Z (Allwinner). Mixed-suite Trixie build over a bullseye
//               BSP; evidence + build plan: radxa-a733-cli's
//               Documentation/trixie-cli-feasibility.md.

function(suite,
         product,
         temp_dir,
         vendor_packages,
         linux_override,
         firmware_override,
) base_packages(suite,
                product,
                temp_dir,
                vendor_packages,
                linux_override,
                firmware_override,
) + (
    // --- rk3566 headless tuning ---
    if std.contains(product_soc_array(product), "rk3566")
    then {
        mmdebstrap+: {
            // Package tuning: the stock `base` set is already lean and SoC-appropriate,
            // so v1 ships it as-is to establish a booting baseline. Trim candidates
            // (e.g. `samba`) are tracked in rsdk-build-notes.md and applied only after a
            // verified boot — never trim blind.

            // --- HARD REQUIREMENT: Wi-Fi + Bluetooth (Zero 3W, AIC8800D80) ---
            // Wi-Fi is SDIO; Bluetooth is UART on ttyS1 (NOT USB). The driver is the
            // out-of-tree DKMS pair aic8800_bsp + aic8800_fdrv, and BT only comes up
            // because rsetup ships systemd units that GPIO-reset the radio and run
            // `hciattach` on ttyS1. These all normally arrive via task-radxa-zero3 +
            // --install-recommends (rk3566/bookworm has recommends on), the same path
            // the stock kde image uses — but we pin them explicitly so the kde->cli
            // delta can never silently drop wireless. Names captured from the working
            // stock image; full analysis in radxa-zero3-cli's
            // Documentation/bluetooth-provisioning.md.
            // (Headers for the DKMS build are installed by core's essential-hook, which
            //  runs before this main package install. Userland Wi-Fi mgmt — network-manager,
            //  wpasupplicant, iw, wireless-regdb, rfkill — comes from core/base.)
            packages+: [
                "aic8800-firmware",            // Wi-Fi + BT firmware blobs (aic8800_fw/SDIO/aic8800D80)
                "aic8800-sdio-dkms",           // out-of-tree driver: aic8800_bsp + aic8800_fdrv
                "rsetup-config-aic8800-ttys1", // BT bring-up: aic8800 reset + hciattach @ttyS1 units
                "bluez",                       // BT userspace (bluetoothd/bluetoothctl); explicit for safety

                // --- Timezone database ---
                // The stock base set installs only UTC zone data, so users can't switch
                // zones. Ship tzdata so `timedatectl set-timezone <Zone>` works. Default
                // stays UTC — neutral, correct for a public image; we don't bake a region in.
                "tzdata",
            ],

            "customize-hooks"+: [
                // NOTE: no SSH hooks here on purpose. Radxa's rsetup first-boot
                // (/config/before.txt) already disables ssh, runs `regenerate_ssh_hostkey`
                // (unique per-device host keys), and does `if headless enable_service ssh`.
                // GlyphDeck units have a display (touchscreen) so they're never "headless";
                // SSH there is an admin toggle exposed via a GDC command (off by default).
                // Our old ssh-enable + host-key-regen hooks just fought/duplicated that, so
                // they were removed (2026-06-30). See radxa-zero3-cli memory
                // ssh-first-boot-and-gdc-toggle + Documentation.

                // --- Boot fix: U-Boot serial-menu hang ---
                // Radxa's discontinued CLI image hung at boot (last line "Starting
                // kernel..."): U-Boot forced an interactive extlinux menu selection over
                // the UART2 serial console, so a headless board waited at the prompt
                // forever. Desktop booted to HDMI and never hit it. Fix = make the menu
                // non-interactive (PROMPT/TIMEOUT 0) in the source conf, so the
                // `u-boot-update` that rootfs.jsonnet runs right after this hook — and any
                // future `apt upgrade` that re-runs it — regenerates a non-blocking
                // extlinux.conf. Ref: AqualinkD-Radxa-zero3; rsdk-build-notes.md.
                //
                // $1 = mounted rootfs. The `cat`s are deliberate: first real build must
                // confirm the actual variable names in radxa.conf (VERIFY-ON-FIRST-BUILD)
                // — drop the logging once locked.
                |||
                    set -e
                    conf="$1/usr/share/u-boot-menu/conf.d/radxa.conf"
                    echo "[eglrdsk] rk3566 cli boot fix: disabling interactive U-Boot menu"
                    if [ -f "$conf" ]; then
                        echo "[eglrdsk] radxa.conf BEFORE:"; cat "$conf"
                        for var in U_BOOT_PROMPT U_BOOT_TIMEOUT; do
                            if grep -qE "^[[:space:]]*#?[[:space:]]*${var}=" "$conf"; then
                                sed -i -E "s|^[[:space:]]*#?[[:space:]]*${var}=.*|${var}=\"0\"|" "$conf"
                            else
                                echo "${var}=\"0\"" >> "$conf"
                            fi
                        done
                        echo "[eglrdsk] radxa.conf AFTER:"; cat "$conf"
                    else
                        echo "[eglrdsk] WARNING: $conf not found — boot fix not applied; check the BSP boot package."
                    fi
                |||,
            ],
        },
    }
    else if std.contains(product_soc_array(product), "a733")
    then {
        mmdebstrap+: {
            // --- Allwinner A733 (Cubie A7A/A7S/A7Z) headless tuning ---
            // Mixed-suite build: Radxa's A733 BSP (5.15 kernel / U-Boot / DT overlays) is
            // published only for bullseye, so those three arrive via
            // `rsdk build radxa-a733 trixie cli --debs <dir>` (local-apt-repository, pin
            // 1999); the userland board packages below are native Trixie. The dependency
            // closure resolves and the DKMS modules compile against the 5.15 headers under
            // Trixie gcc-14 — both verified 2026-07-04. Full evidence + open items:
            // radxa-a733-cli/Documentation/trixie-cli-feasibility.md.

            // --- HARD REQUIREMENT: Wi-Fi + Bluetooth (AICSemi AIC8800D80, USB-attached) ---
            // Unlike the Zero 3 (SDIO Wi-Fi + UART BT on ttyS1), the A733 radio sits on USB:
            // both Wi-Fi (aic8800_fdrv) and BT (aic_btusb) enumerate over USB, so there is NO
            // hciattach/ttyS1 unit — hci0 comes up directly. Driver is the out-of-tree
            // aic8800-usb-dkms, built at image time against the 5.15 headers (compile
            // verified). The driver does not register through nl80211, so on a headless box
            // Wi-Fi is managed with NetworkManager/nmcli, not iw/wpa_supplicant (userland
            // net mgmt comes from core/base). These normally arrive via task-radxa-a733 +
            // --install-recommends (a733 has recommends-on for trixie), but we pin them so
            // the kde->cli delta can never silently drop wireless.
            //
            // NOTE: the aic8800 DKMS build needs a compiler, and gcc reaches the image ONLY
            // via dkms's Recommends — do NOT build this edition with --no-install-recommends
            // or the module build has no compiler. (Verified via closure sim, 2026-07-04.)
            packages+: [
                "aic8800-firmware",                     // Wi-Fi + BT firmware blobs
                "aic8800-usb-dkms",                     // out-of-tree USB driver: aic8800_fdrv + aic_btusb
                "radxa-system-config-aic8800-usb-dkms", // system config for the USB radio variant
                "bluez",                                // BT userspace (bluetoothd/bluetoothctl)

                // --- USB-C OTG ---
                // On the A733, OTG is a userland package (radxa-otgutils), not a DT overlay.
                "radxa-otgutils",

                // --- Device-tree overlays ---
                // Optional-peripheral toggles, shipped disabled, applied via rsetup. The DKMS
                // package compiles .dtbo via dtc against the 5.15 headers (verified). The base
                // DTB (inside the kernel deb) boots the board headless with no overlay applied.
                "radxa-overlays-dkms",

                // --- Timezone database ---
                // Stock base ships only UTC zone data; add tzdata so `timedatectl
                // set-timezone <Zone>` works. Default stays UTC — neutral for a public image.
                "tzdata",
            ],

            "customize-hooks"+: [
                // --- Boot fix candidate: U-Boot serial-menu hang (UNVERIFIED on a733) ---
                // The Zero 3 CLI image hung at boot on an interactive extlinux menu forced
                // over the serial console (headless board waited at the prompt forever).
                // Whether the A733 U-Boot exhibits the same hang is NOT yet confirmed — needs
                // UART on the board (trixie-cli-feasibility.md open item). Making the menu
                // non-interactive is harmless if the hang never occurs, so we ship the same
                // fix + verify-on-first-build logging as rk3566. The `u-boot-update` that
                // rootfs.jsonnet runs after this hook (and any later `apt upgrade`)
                // regenerates a non-blocking extlinux.conf from the patched source conf.
                // A733 serial console is ttyAS0 (Allwinner UART), not ttyS*. $1 = mounted rootfs.
                |||
                    set -e
                    conf="$1/usr/share/u-boot-menu/conf.d/radxa.conf"
                    echo "[eglrdsk] a733 cli boot fix: disabling interactive U-Boot menu"
                    if [ -f "$conf" ]; then
                        echo "[eglrdsk] radxa.conf BEFORE:"; cat "$conf"
                        for var in U_BOOT_PROMPT U_BOOT_TIMEOUT; do
                            if grep -qE "^[[:space:]]*#?[[:space:]]*${var}=" "$conf"; then
                                sed -i -E "s|^[[:space:]]*#?[[:space:]]*${var}=.*|${var}=\"0\"|" "$conf"
                            else
                                echo "${var}=\"0\"" >> "$conf"
                            fi
                        done
                        echo "[eglrdsk] radxa.conf AFTER:"; cat "$conf"
                    else
                        echo "[eglrdsk] WARNING: $conf not found — boot fix not applied; check the BSP boot package."
                    fi
                |||,
            ],
        },
    }
    else {}
)
